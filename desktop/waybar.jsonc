// foxden desktop bar
{
  "layer": "top",
  "position": "top",
  "height": 34,

  "modules-left": ["custom/start", "wlr/taskbar"],
  "modules-right": ["sway/workspaces", "cpu", "memory", "clock"],

  "custom/start": {
    "format": "☰  Start",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "/etc/foxden/start-menu.xml",
    "menu-actions": {
      "terminal": "foot",
      "browser": "chromium",
      "files": "thunar",
      "apps": "fuzzel"
    }
  },

  "wlr/taskbar": {
    "format": "{icon} {title:.30}",
    "icon-size": 18,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5
  },

  // The container runs on UTC.
  "clock": {
    "format": "{:%Y-%m-%d %H:%M} UTC",
    "tooltip": false
  }
}
