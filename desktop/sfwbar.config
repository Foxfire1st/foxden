#Api2
# foxden desktop bar (sfwbar): start menu, taskbar of the
# current desktop, desktops, CPU, RAM, clock and the shortcut
# overview. Layout first, colours below the #CSS line.

# ------------------------------------------------------------
# Figures for the CPU and RAM labels
# ------------------------------------------------------------
file("/proc/stat") {
  CpuUser = RegEx("^cpu +([0-9]+)")
  CpuNice = RegEx("^cpu +[0-9]+ ([0-9]+)")
  CpuSystem = RegEx("^cpu +(?:[0-9]+ ){2}([0-9]+)")
  CpuIdle = RegEx("^cpu +(?:[0-9]+ ){3}([0-9]+)")
}

file("/proc/meminfo") {
  MemTotal = RegEx("^MemTotal: +([0-9]+)")
  MemAvailable = RegEx("^MemAvailable: +([0-9]+)")
}

# .pval is the value of the previous reading.
Set CpuBusy = (CpuUser-CpuUser.pval) + (CpuNice-CpuNice.pval) + (CpuSystem-CpuSystem.pval)
Set CpuUsage = CpuBusy / (CpuBusy + CpuIdle-CpuIdle.pval)
Set MemUsage = (MemTotal-MemAvailable) / MemTotal

# ------------------------------------------------------------
# Desktops
# ------------------------------------------------------------
# bar.sh writes the state of the desktops to this file: one line
# with d<number>=<0 closed, 1 open, 2 current> for each of them.
file("/tmp/agent-runtime/desktops.state") {
  Desktop1 = RegEx("d1=([0-9])")
  Desktop2 = RegEx("d2=([0-9])")
  Desktop3 = RegEx("d3=([0-9])")
  Desktop4 = RegEx("d4=([0-9])")
  Desktop5 = RegEx("d5=([0-9])")
  Desktop6 = RegEx("d6=([0-9])")
  Desktop7 = RegEx("d7=([0-9])")
  Desktop8 = RegEx("d8=([0-9])")
  Desktop9 = RegEx("d9=([0-9])")
}

Function DesktopStyle(state) {
  Return If(state = 2, "desktop_current", If(state = 1, "desktop", "hidden"));
}

# Lets the desktop labels update whenever the file changes.
function("SfwbarInit") {
  FileTrigger("/tmp/agent-runtime/desktops.state", "desktops");
}

# ------------------------------------------------------------
# Start menu
# ------------------------------------------------------------
# SwayCmd("exec …") lets Sway start the program, like a key
# binding does.
menu "start" {
  item { value = "Terminal"; action = SwayCmd("exec xfce4-terminal"); }
  item { value = "Chromium"; action = SwayCmd("exec chromium"); }
  item { value = "Files"; action = SwayCmd("exec thunar"); }
  separator;
  item { value = "All programs …"; action = SwayCmd("exec fuzzel"); }
}

# ------------------------------------------------------------
# Bar
# ------------------------------------------------------------
bar "sfwbar" {
  edge = "top"
  layer = "top"
  exclusive_zone = "auto"

  label {
    value = "☰  Start"
    style = "start"
    action = Menu("start")
  }

  # Only the windows of the current desktop. Titles are at most
  # title_width characters long and shrink when room gets tight.
  # sort = false keeps the windows in the order they were opened.
  # Without the LeftClick action a click on the focused window
  # would send it to Sway's scratchpad.
  taskbar {
    rows = 1
    icons = true
    labels = true
    title_width = 30
    filter = workspace
    sort = false
    tooltips = true
    css = "* { -GtkWidget-vexpand: true; }"
    action[LeftClick] = Focus()
    action[MiddleClick] = Close()
  }

  # Empty label that takes the free room and pushes the rest to
  # the right.
  label { css = "* { -GtkWidget-hexpand: true; }" }

  # A desktop is a Sway workspace. One label per possible desktop;
  # those that are not open are hidden.
  label {
    value = "Desktop"
    style = "desktops"
  }

  label { value = "1"; trigger = "desktops"; style = DesktopStyle(Desktop1); action = SwayCmd("workspace number 1"); }
  label { value = "2"; trigger = "desktops"; style = DesktopStyle(Desktop2); action = SwayCmd("workspace number 2"); }
  label { value = "3"; trigger = "desktops"; style = DesktopStyle(Desktop3); action = SwayCmd("workspace number 3"); }
  label { value = "4"; trigger = "desktops"; style = DesktopStyle(Desktop4); action = SwayCmd("workspace number 4"); }
  label { value = "5"; trigger = "desktops"; style = DesktopStyle(Desktop5); action = SwayCmd("workspace number 5"); }
  label { value = "6"; trigger = "desktops"; style = DesktopStyle(Desktop6); action = SwayCmd("workspace number 6"); }
  label { value = "7"; trigger = "desktops"; style = DesktopStyle(Desktop7); action = SwayCmd("workspace number 7"); }
  label { value = "8"; trigger = "desktops"; style = DesktopStyle(Desktop8); action = SwayCmd("workspace number 8"); }
  label { value = "9"; trigger = "desktops"; style = DesktopStyle(Desktop9); action = SwayCmd("workspace number 9"); }

  label {
    value = "+"
    style = "desktop_button"
    tooltip = "New desktop"
    action = Exec("sh /etc/foxden/desktops.sh add")
  }

  label {
    value = "×"
    style = "desktop_button"
    tooltip = "Close desktop, windows move to its neighbour"
    action = Exec("sh /etc/foxden/desktops.sh close")
  }

  label {
    style = "status"
    interval = 5000
    value = "CPU " + Str(CpuUsage * 100) + "%"
  }

  label {
    style = "status"
    interval = 5000
    value = "RAM " + Str(MemUsage * 100) + "%"
  }

  # The container runs on UTC.
  label {
    style = "status"
    interval = 5000
    value = Time("%Y-%m-%d %H:%M") + " UTC"
  }

  label {
    value = "⌨  Keys"
    style = "shortcuts"
    tooltip = "Show keyboard shortcuts"
    action = Exec("sh /etc/foxden/shortcuts.sh")
  }
}

#CSS
* {
  font-family: "DejaVu Sans", sans-serif;
  font-size: 13px;
}

window#sfwbar {
  background: #1a1b26;
  color: #c0caf5;
}

/* Height of the bar */
grid#layout {
  min-height: 34px;
}

label {
  color: #c0caf5;
}

button {
  border: none;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
  background-image: none;
  color: #c0caf5;
  padding: 0 8px;
  min-height: 0;
}

button:hover {
  background: #2f334d;
}

/* Everything fills the height of the bar. */
label#start,
label#desktops,
label#desktop,
label#desktop_current,
label#desktop_button,
label#status,
label#shortcuts,
button#taskbar_item {
  -GtkWidget-vexpand: true;
}

#hidden {
  -GtkWidget-visible: false;
}

label#start {
  padding: 0 12px;
  background: #7aa2f7;
  color: #1a1b26;
  font-weight: bold;
}

button#taskbar_item grid,
button#taskbar_item label,
button#taskbar_item image {
  -GtkWidget-vexpand: true;
  -GtkWidget-valign: center;
}

button#taskbar_item image {
  min-width: 18px;
  min-height: 18px;
  padding-right: 6px;
}

button#taskbar_item.focused,
label#desktop_current {
  background: #2f334d;
  border-bottom: 2px solid #7aa2f7;
}

label#desktops {
  padding: 0 4px 0 10px;
}

label#desktop,
label#desktop_current {
  padding: 0 8px;
}

label#desktop_button,
label#status,
label#shortcuts {
  padding: 0 10px;
}

label#desktop_button {
  font-weight: bold;
}

menu {
  background: #1a1b26;
  color: #c0caf5;
}
